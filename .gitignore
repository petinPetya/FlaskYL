# Файлы PyCharm
#  Отдельный шаблон JetBrains поддерживается в JetBrains.gitignore:
#  https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  Его можно добавить в глобальный gitignore или объединить с этим файлом.
#  Более жёсткий вариант (не рекомендуется) - раскомментировать строку ниже и игнорировать всю папку idea.
#.idea/

# Файлы Abstra
# Abstra - это фреймворк автоматизации процессов с AI.
# Здесь игнорируются каталоги с пользовательскими учётными данными, локальным состоянием и настройками.
# Подробнее: https://abstra.io/docs
.abstra/

# Файлы Visual Studio Code
#  Отдельный шаблон для Visual Studio Code поддерживается в VisualStudioCode.gitignore:
#  https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#  Его можно добавить в глобальный gitignore или объединить с этим файлом.
#  При желании можно раскомментировать строку ниже и игнорировать всю папку vscode.
# .vscode/

# Файлы Ruff:
.ruff_cache/

# Файл конфигурации PyPI
.pypirc

# Файлы Cursor
#  Cursor - это AI-редактор кода. `.cursorignore` задаёт файлы и каталоги,
#  которые нужно исключить из AI-функций вроде автодополнения и анализа кода.
#  Для чувствительных данных см. https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore
.codex

