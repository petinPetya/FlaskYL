# Шаблон файла окружения для локальной разработки.
# Скопировать его в `flask-env` и подставить свои значения:
#   cp flask-env.example flask-env
# Затем загрузить его в shell перед запуском Flask:
#   set -a; source flask-env; set +a
#
# ВАЖНО: не коммитить настоящий файл `flask-env`.
#
# Если `DATABASE_URL` не задан, приложение использует локальную SQLite-базу:
#   instance/site.db
#
# Flask / приложение
export SECRET_KEY='change-me-in-production'
export LOG_LEVEL='INFO'
export PREFERRED_URL_SCHEME='http'
export BOOTSTRAP_SCHEMA_ON_STARTUP='1'

# Файлы cookie
export SESSION_COOKIE_SECURE='0'
export REMEMBER_COOKIE_SECURE='0'

# База данных
# SQLite (по умолчанию): не задавай DATABASE_URL.
#
# Пример для PostgreSQL (нужны сама БД и установленный драйвер):
export DATABASE_URL='postgresql+psycopg://user:password@127.0.0.1:15433/lowlands_vpn'

# VPN SSH интеграция (опционально)
export VPN_AUTO_PROVISION='0'
export VPN_SSH_COMMAND_TIMEOUT='20'
export VPN_SSH_COMMAND_RETRIES='1'
export VPN_SSH_RETRY_BACKOFF_SECONDS='0.75'
export VPN_REMOTE_UPDATE_EMAIL_SCRIPT='/usr/local/sbin/xray-update-client-email'

# Email verification (опционально)
export EMAIL_VERIFICATION_ENABLED='1'
export EMAIL_VERIFICATION_REQUIRED='0'
# Подтверждение выполняется вручную администратором (SMTP не используется).
